        "sourceReleaseId": {
          "type": "string",
          "minLength": 1
        },
        "sourceLocator": {
          "type": "string",
          "minLength": 1
        },
        "licenseId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "available"
          ]
        }
      },
      "required": [
        "characterId",
        "glyph",
        "locale",
        "glyphStandard",
        "url",
        "strokeCount",
        "version",
        "sha256",
        "sourceReleaseId",
        "sourceLocator",
        "licenseId",
        "status"
      ]
    },
    "KanjiRelation": {
      "type": "object",
      "additionalProperties": false,
