{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hanzifun.local/data/foundation.schema.json",
  "title": "HF-02 normalized data bundle",
  "definitions": {
    "Character": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "characterId": {
          "type": "string",
          "pattern": "^char:[0-9a-f]{4,6}$"
        },
        "glyph": {
          "type": "string",
          "minLength": 1
        },
        "readingId": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "primaryReadingId": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "radical": {
          "type": "string",
          "minLength": 1
        },
        "structure": {
          "enum": [
            "single-component",
            "left-right",
            "top-bottom",
            "left-middle-right",
            "top-middle-bottom",
            "full-enclosure",
            "upper-enclosure",
            "lower-enclosure",
            "left-enclosure",
            "upper-left-enclosure",
            "upper-right-enclosure",
            "lower-left-enclosure",
            "overlaid"
          ]
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ids": {
              "type": "string",
              "minLength": 1
            },
            "completeness": {
              "enum": [
                "partial",
                "complete"
              ]
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sourceReleaseId": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceLocator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "sourceReleaseId",
                "sourceLocator"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "ids",
            "completeness",
            "evidence",
            "note"
          ]
        },
        "strokeCount": {
          "type": "integer",
          "minimum": 1
        },
        "locale": {
          "enum": [
            "zh-Hans-CN"
          ]
        },
        "scriptRelations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "simplified": {
                "type": "string",
                "minLength": 1
              },
              "traditional": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "enum": [
                  "same-form",
                  "different-form"
                ]
              },
              "readingId": {
                "type": "string",
                "minLength": 1
              },
              "senses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "sourceReleaseId": {
                "type": "string",
                "minLength": 1
              },
              "sourceLocator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "simplified",
              "traditional",
              "relation",
              "readingId",
              "senses",
              "sourceReleaseId",
              "sourceLocator"
            ]
          }
        },
        "unicodeVariants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "glyph": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "traditional-candidate",
                  "simplified-candidate"
                ]
              },
              "context": {
                "type": "string",
                "minLength": 1
              },
              "sourceReleaseId": {
                "type": "string",
                "minLength": 1
              },
              "sourceLocator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "glyph",
              "kind",
              "context",
              "sourceReleaseId",
              "sourceLocator"
            ]
          }
        },
        "unihanStrokeCounts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "values": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "interpretation": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sourceReleaseId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceLocator": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "sourceReleaseId",
                    "sourceLocator"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "alternates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "count",
                  "irgSources",
                  "evidence"
                ],
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "irgSources": {
                    "type": "string",
                    "pattern": "^[BGHJKMPSTUV]+$"
                  },
                  "evidence": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "sourceReleaseId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sourceLocator": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "sourceReleaseId",
                      "sourceLocator"
                    ]
                  }
                }
              }
            }
          },
          "required": [
            "values",
            "interpretation",
            "evidence",
            "alternates"
          ]
        },
        "contentTier": {
          "enum": [
            "Tier1",
            "Tier2"
          ]
        },
        "reviewStatus": {
          "enum": [
            "draft",
            "reviewed"
          ]
        },
        "publicationStatus": {
          "enum": [
            "draft",
            "reviewed",
            "published",
            "archived"
          ]
        },
        "sourceReferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "origins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "characterId",
        "glyph",
        "readingId",
        "primaryReadingId",
        "definition",
        "radical",
        "structure",
        "components",
        "strokeCount",
        "locale",
        "scriptRelations",
        "unicodeVariants",
        "unihanStrokeCounts",
        "contentTier",
        "reviewStatus",
        "publicationStatus",
        "sourceReferences",
        "origins"
      ]
    },
    "Reading": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readingId": {
          "type": "string",
          "minLength": 1
