          ]
        },
        "sourceReferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "wordId",
        "simplified",
        "traditionalForms",
        "readingId",
        "componentCharacterIds",
        "coreCharacterIds",
        "coverageStatus",
        "reviewStatus",
        "sourceReferences"
      ]
    },
    "StrokeAsset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "characterId": {
          "type": "string",
          "pattern": "^char:[0-9a-f]{4,6}$"
        },
        "glyph": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "enum": [
            "zh-Hans-CN"
          ]
        },
        "glyphStandard": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "strokeCount": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
