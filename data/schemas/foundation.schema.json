          "enum": [
            "verified",
            "pending",
            "not-in-consulted-source"
          ]
        },
        "japaneseGlyph": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "relationType": {
          "anyOf": [
            {
              "enum": [
                "same-character",
                "different-corresponding-form"
              ]
            },
