            },
            "marked": {
              "type": "string",
              "minLength": 1
            },
            "plain": {
              "type": "string",
              "minLength": 1
            },
            "search": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "syllables": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "numeric",
            "marked",
            "plain",
            "search",
            "syllables"
          ]
        },
        "senses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "traditionalForms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sourceReleaseId": {
                "type": "string",
                "minLength": 1
              },
              "sourceLocator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sourceReleaseId",
              "sourceLocator"
            ]
          }
        },
        "sourceReferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reviewStatus": {
          "enum": [
            "draft",
            "reviewed"
          ]
        }
      },
      "required": [
        "readingId",
        "itemId",
        "pinyin",
        "senses",
        "traditionalForms",
        "evidence",
        "sourceReferences",
        "reviewStatus"
      ]
    },
    "Lexeme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wordId": {
          "type": "string",
          "minLength": 1
        },
        "simplified": {
          "type": "string",
          "minLength": 1
        },
        "traditionalForms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "readingId": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "componentCharacterIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^char:[0-9a-f]{4,6}$"
          }
        },
        "coreCharacterIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^char:[0-9a-f]{4,6}$"
          }
        },
        "coverageStatus": {
          "enum": [
            "dictionary-attested",
            "missing-dictionary"
          ]
        },
        "reviewStatus": {
          "enum": [
            "draft",
