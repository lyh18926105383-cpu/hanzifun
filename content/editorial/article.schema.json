{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "articles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hf13-v1"
    },
    "articles": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "title",
          "description",
          "category",
          "status",
          "author",
          "created",
          "modified",
          "published",
          "characterIds",
          "deck",
          "lead",
          "sections",
          "references",
          "review"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 15
          },
          "description": {
            "type": "string",
            "minLength": 40,
            "maxLength": 220
          },
          "category": {
            "enum": [
              "culture",
              "travel-business",
              "family"
            ]
          },
          "status": {
            "enum": [
              "draft",
              "reviewed",
              "published",
              "archived"
            ]
          },
          "author": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "ai",
                  "human"
                ]
              }
            }
          },
          "created": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "modified": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "published": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "characterIds": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^char:[0-9a-f]{4,6}$"
            }
          },
          "deck": {
            "type": "string",
            "minLength": 1
          },
          "lead": {
            "type": "string",
            "minLength": 40
          },
          "sections": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "paragraphs"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 5
                },
                "paragraphs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 40
                  }
                }
              }
            }
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "url",
                "accessed",
                "scope"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "accessed": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "image": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "src",
              "alt"
            ],
            "properties": {
              "src": {
                "type": "string",
                "pattern": "^/site-assets/"
              },
              "alt": {
                "type": "string",
                "minLength": 5
              }
            }
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "acceptance",
              "reviewer",
              "date",
              "contentSha256",
              "evidence"
            ],
            "properties": {
              "acceptance": {
                "enum": [
                  "pending",
                  "approved"
                ]
              },
              "reviewer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "contentSha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
